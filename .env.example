APP_NAME=Mcars
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_SERVICE=app
APP_USER=www-data

# fr is the working language for staff; ar is required for contracts (RTL).
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Algiers

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is not optional (ADR-002): the bookings EXCLUDE constraint that
# makes double-booking impossible has no MySQL equivalent.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=mcars
DB_USERNAME=mcars
DB_PASSWORD=secret
DB_PORT_HOST=5432

# AdminUserSeeder reads these for the first login it creates. Required in
# production — the seed refuses to run without them rather than falling back
# to a guessable default. Local/CI need no values here; they fall back to
# admin@mcars.local / password.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mcars

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@mcars.local"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_UI_PORT=8025

# --- Mcars ---------------------------------------------------------------

MCARS_CURRENCY=DZD

# Multi-branch behaviour (scope, switcher). Columns exist from Phase 0; the
# behaviour is switched on in Phase 10. See docs/08-multi-branch-retrofit.md.
BRANCHES_ENABLED=false

# Browsershot / spatie-laravel-pdf. Chromium ships in the app image; Arabic RTL
# contracts render correctly through headless Chrome, not through dompdf.
BROWSERSHOT_NODE_BINARY=/usr/bin/node
BROWSERSHOT_NPM_BINARY=/usr/bin/npm
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium

# Messaging (Phase 8, ADV-05). Provider still to be chosen — see docs/README.md.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_DRIVER=log
SMS_API_KEY=

# Backups (Phase 10, ADV-04).
BACKUP_DISK=local
BACKUP_NOTIFY_EMAIL=

# Notifications & alerts (Phase 8).
# Alerts are delivered through swappable drivers registered in
# config/notifications.php. Adding a provider is a driver class plus a key here —
# no calling code changes.
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_TRIES=3
NOTIFICATIONS_DEFAULT_LOCALE=fr
NOTIFICATIONS_MAX_SUBJECTS_PER_RULE=500

# Discord incoming webhooks. Leave DISCORD_ALERTS_ENABLED false and the channel is
# skipped entirely — no rows are queued for it.
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=Mcars
DISCORD_TIMEOUT=10
# Optional per-topic routing; falls back to DISCORD_WEBHOOK_URL.
DISCORD_WEBHOOK_FINANCE=
DISCORD_WEBHOOK_WORKSHOP=
DISCORD_WEBHOOK_OPS=


VITE_APP_NAME="${APP_NAME}"



sorica = 11 , 18 30day
ziranda = 10 . 19 30days


cevita 15 , 21mil  45 days 